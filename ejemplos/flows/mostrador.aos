; LISPAI-AOS — ATS-001 flow completo (dominio + UI + test + deploy)
(flow cafeteria-mostrador
  (version "1.0.0")
  (desc "Mostrador: stock, venta, UI-orge, tests y deploy multi-dispositivo")

  (orge stock
    (kind ORGES)
    (desc "Disponibilidad de insumos")
    (cap "stock.consultar" "stock.actualizar")
    (provides "stock.consulta" "1.0")
    (goal "disponibilidad")
    (state (stock.unidades 10) (stock.umbral 3) (stock.alerta false))
    (rule alerta_bajo
      (when (lte stock.unidades 3))
      (then stock.alerta true)))

  (orge venta
    (kind ORGES)
    (desc "Venta de mostrador")
    (cap "venta.registrar")
    (requires "stock.consulta" "1.0")
    (goal "cobro")
    (state (venta.habilitada false) (venta.ultima null))
    (rule listo
      (when (gt stock.unidades 0))
      (then venta.habilitada true)
      (indeterminate false)))

  (orge ui-mostrador
    (kind UI)
    (desc "Superficie declarativa")
    (cap "ui.render")
    (ui
      (column
        (label "Cafeteria · mostrador")
        (badge (bind stock.unidades))
        (row
          (button "+" (emit stock.inc))
          (button "-" (emit stock.dec))
          (button "Vender" (emit venta.registrar))))))

  (assemble stock venta ui-mostrador)
  (bind venta stock stock.consulta 1.0)
  (surface ui-mostrador)

  (test stock-inicial (eq stock.unidades 10))
  (deploy web
    (devices mobile tablet desktop)
    (out ./dist/cafeteria-mostrador))
)
